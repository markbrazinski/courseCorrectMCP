      "id": "stp_633e628dff",
      "title": "Heat the stock",
      "technique": "HEAT_STOCK",
      "text": "Bring {use:use_f0c64c953e} to a simmer and keep it hot."
    },
    {
      "id": "stp_bdcf181778",
      "title": "Soften the onion",
      "technique": "SOFTEN",
      "text": "Melt {use:use_b95dfa003c} in a wide pan over medium heat. Add {use:use_680ed65c48} and cook until soft, about 5 minutes.",
      "duration": [
        300,
        "5 min"
      ]
    },
    {
      "id": "stp_6216193b43",
      "title": "Add the garlic",
      "technique": "SAUTE",
      "text": "Add {use:use_6625d00d5e} and cook for 30 seconds.",
      "duration": [
        30,
        "30 sec"
      ]
    },
    {
      "id": "stp_284f435fb7",
      "title": "Toast the rice",
      "technique": "TOAST_RICE",
      "text": "Add {use:use_519a7195cc} and stir until the edges turn translucent, 2–3 minutes.",
      "duration": [
        120,
        "2 min · recipe says 2–3"
      ]
    },
    {
      "id": "stp_90886a9713",
      "title": "Add the wine",
      "technique": "DEGLAZE",
      "text": "Pour in {use:use_9e5a387dfb} and stir until absorbed."
    },
    {
      "id": "stp_c4de53b9b5",
      "title": "Cook with the stock",
      "technique": "LADLE_STOCK",
      "text": "Add {use:use_e6d0cc2a3a} a ladle at a time, stirring, until the rice is creamy and just tender, 18–20 minutes.",
      "duration": [
        1080,
        "18 min · recipe says 18–20"
      ]
    },
    {
      "id": "stp_a7a4b466eb",
      "title": "Finish",
      "technique": "OFF_HEAT_FINISH",
      "text": "Off the heat, stir in {use:use_4b514b988b} and {use:use_0d7ebe8986}. Season with {use:use_2c8b094797}."
    },
    {
      "id": "stp_4e8f239de3",
      "title": "Rest and serve",
      "technique": "REST",
      "text": "Rest for 1 minute, then serve.",
      "duration": [
        60,
        "1 min"
      ]
    }
