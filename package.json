{
  "name": "coursecorrect-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p src/web",
    "test": "vitest run",
    "serve": "node --disable-warning=ExperimentalWarning src/service/main.ts",
    "walkthrough": "node --disable-warning=ExperimentalWarning src/walkthrough.ts",
    "walkthrough:m2": "node --disable-warning=ExperimentalWarning src/walkthrough-m2.ts",
    "probe:m2": "node --disable-warning=ExperimentalWarning src/probes/m2-probe.ts",
    "build:web": "vite build",
    "start": "npm run build:web && npm run serve",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "serve:live": "npm run build:web && CC_LIVE=1 CC_DEMO=1 CC_FIXTURE_RECIPES=1 CC_INTERPRETER=nova CC_SPEECH=polly CC_EXPLAINER=nova CC_DB=.artifacts/walkthrough/m3-live.db node --disable-warning=ExperimentalWarning src/service/main.ts",
    "evidence:m3": "node --disable-warning=ExperimentalWarning src/probes/m3-evidence.ts",
    "transfer": "node --disable-warning=ExperimentalWarning src/probes/transfer.ts",
    "probe:cards": "node --disable-warning=ExperimentalWarning src/probes/cards-probe.ts",
    "demo": "npm run build:web && node --disable-warning=ExperimentalWarning src/demo/rehearse.ts",
    "demo:export": "node --disable-warning=ExperimentalWarning src/demo/export.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1139.0",
    "@aws-sdk/client-polly": "3.1145.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
